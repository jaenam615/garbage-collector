echo 자동 GC가 여러 번 돌아도 루트에서 닿는 객체는 멀쩡하다
gc_create 4096
gc_alloc keep 1 32
write keep KEEP_ME_ALIVE
gc_push_root keep
gc_alloc child 0 16
write child CHILD
object_set_ref keep 0 child
repeat 1000 gc_alloc t 1 64
expect collections >= 1
expect data keep KEEP_ME_ALIVE
expect ref keep 0 child
expect data child CHILD
