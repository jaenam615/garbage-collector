echo Old 객체만 가리키는 young 객체: minor GC는 Old를 훑지 않으므로 write barrier로 기억해 둬야 산다
gen_create 4K 4K 64K 2
gen_alloc o 1 8
gen_push_root o
gen_minor_gc
gen_minor_gc
expect space o old
gen_alloc y 0 16
write y YOUNG_CHILD
gen_write_ref o 0 y
gen_minor_gc
expect copied == 1
expect refspace o 0 survivor
expect refdata o 0 YOUNG_CHILD
gen_minor_gc
expect refspace o 0 old
expect refdata o 0 YOUNG_CHILD
